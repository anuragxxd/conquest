# Conquest Runner Image
#
# Contains: Java (Corretto 21) + Nextflow + nf-ga4gh plugin + nf-amazon plugin + conquest binary
# Used as the runner Job image for executing Nextflow workflows via TES.
#
# Build: docker buildx build --platform linux/amd64 -f Dockerfile.runner -t <tag> --push .

# ---- Build conquest binary ----
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS go-builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-s -w" -o /conquest ./cmd/conquest/

# ---- Runtime: Java + Nextflow + plugins ----
FROM amazoncorretto:21-al2023

# Install system dependencies.
RUN yum install -y procps-ng shadow-utils which git bash hostname \
    && yum clean all

# Create non-root user.
RUN useradd -u 1000 -m conquest

# Set Nextflow home.
ENV NXF_HOME=/.nextflow

# Install Nextflow.
ARG NXF_VER=24.10.4
RUN curl -fsSL get.nextflow.io | bash \
    && mv nextflow /usr/local/bin/nextflow \
    && chmod 755 /usr/local/bin/nextflow \
    && mkdir -p /.nextflow \
    && chown -R 1000:1000 /.nextflow

# Pre-install a curated plugin set for this image. Platform plugins should be
# listed here; workflow plugins can be added per image when we want to reduce
# runtime plugin downloads.
ARG NXF_PREINSTALL_PLUGINS="nf-ga4gh@1.3.0 nf-amazon@2.9.0"
RUN set -eux; \
    for plugin in ${NXF_PREINSTALL_PLUGINS}; do \
        su conquest -c "nextflow plugin install ${plugin}"; \
    done; \
    chown -R 1000:1000 /.nextflow

# Copy conquest binary.
COPY --from=go-builder /conquest /usr/local/bin/conquest
RUN chmod 755 /usr/local/bin/conquest

# Create writable directories for runtime.
RUN mkdir -p /workspace /tmp \
    && chown -R 1000:1000 /workspace /tmp

# Curated plugin allowlist. The runner pod can override this at runtime.
ARG NXF_PLUGINS_ALLOWED="nf-ga4gh,nf-amazon,nf-schema,nf-core-utils,nf-fgbio,nf-prov"
ENV NXF_PLUGINS_ALLOWED=${NXF_PLUGINS_ALLOWED}
ENV NXF_ANSI_LOG=false

USER 1000:1000
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/conquest"]
